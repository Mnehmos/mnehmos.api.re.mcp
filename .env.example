# mnehmos.api.re.mcp — runtime configuration (copy to .env, never commit .env)
# The engine reads env vars directly; .env support is a convenience of the host.

# Evidence KB location (default: ./apire_kb)
APIRE_KB=

# Capture store location (default: ./apire_kb/captures)
APIRE_CAPTURES_DIR=

# Salt used to pseudonymize credential-shaped values (generate: python -c "import secrets;print(secrets.token_hex(32))")
# If unset, redaction mode defaults to full REDACT (no pseudonymization).
APIRE_REDACTION_SALT=

# Response size limit for MCP tool results (default 120000)
APIRE_MAX_RESPONSE_CHARS=

# Per-capture raw size limit (default 536870912)
APIRE_MAX_CAPTURE_BYTES=

# devtools_attach body fetch cap in bytes (default 8000000); larger responses
# are captured headers-only
APIRE_MAX_BODY_FETCH=

# Explicit authorization statement recorded into every capture session.
# The engine refuses to start a capture without it (see docs/security-model.md).
APIRE_AUTHORIZATION_STATEMENT=
